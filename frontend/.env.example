# StockFlow Environment Variables — Template
# -----------------------------------------------
# Copy this file to .env.local and set real values.
# This file is safe to commit to git.
# -----------------------------------------------

# Application
NEXT_PUBLIC_APP_NAME=StockFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin Credentials (dev / seed)
SUPER_ADMIN_EMAIL=12yemom@gmail.com
SUPER_ADMIN_PASSWORD=Fekerte@zegeye1221
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=12yemom@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_PASSWORD=Fekerte@zegeye1221

# JWT / Session
NEXTAUTH_SECRET=super-secret-change-in-production-32chars
NEXTAUTH_URL=http://localhost:3000

# Backend API — Spring Boot runs on port 8081 mapped to container port 8080
# All REST endpoints are prefixed with /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# Database (used by the Spring Boot backend, not Next.js directly)
DATABASE_URL=postgresql://stockflow:stockflowpassword@localhost:5434/stockflow_db

# Node
NODE_ENV=development
