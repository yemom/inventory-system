# Frontend environment.
#
# Copy to `.env.local` and fill in. Never commit the filled-in file: `.env*`
# is gitignored and only `.env.example` is tracked.
#
# Only the two `NEXT_PUBLIC_*` variables below are read by the browser. Anything
# not prefixed `NEXT_PUBLIC_` stays on the server.

# The URL the browser calls. Public, and therefore safe to expose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# Server-side only. Inside Docker Compose the backend is reachable at
# `backend:8080`, which the browser cannot resolve — so this is used by Next.js
# server components and must never be set to a Compose-internal hostname for
# client-side code. Defaults to NEXT_PUBLIC_API_BASE_URL when unset.
API_INTERNAL_BASE_URL=http://backend:8080/api/v1

# Shown in the header and on the settings screen.
NEXT_PUBLIC_APP_NAME=StockFlow