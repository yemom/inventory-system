# ============================================================
# StockFlow — environment template
#
# Copy to .env and replace every CHANGE_ME_* value:
#   cp .env-example .env
#
# JWT_SECRET and SUPER_ADMIN_PASSWORD are REQUIRED. The backend has no
# built-in defaults for them and refuses to start without them, because a
# signing key or admin password committed to the repository is a public
# credential, not a secret.
#   openssl rand -hex 32     # for JWT_SECRET
#   openssl rand -base64 18  # for SUPER_ADMIN_PASSWORD
#
# NOTE: Docker only applies POSTGRES_PASSWORD / REDIS_PASSWORD when
# the volumes are first created. To change them later you must
# remove the existing volumes first (THIS DELETES ALL DATA):
#   docker compose down -v && docker compose up -d
#
# Keep exactly ONE value per key — duplicate keys silently override
# each other depending on their order in the file.
# ============================================================

# ── POSTGRES CONTAINER ─────────────────────────────────────
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=stockflow_db

# ── DATABASE (Spring Boot) ────────────────────────────────
DATABASE_URL=jdbc:postgresql://db:5432/stockflow_db
DATABASE_USERNAME=stockflow
# Must match POSTGRES_PASSWORD above.
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# ── REDIS ─────────────────────────────────────────────────
# Docker service name, NOT localhost.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────
# Generate a long random value. Rotating it invalidates all sessions.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API, on top of the
# localhost/LAN origins the backend always allows in development.
# REQUIRED in production: without this the deployed frontend is blocked
# by the browser at the preflight and every API call fails.
# Use exact origins, never a wildcard such as https://*.vercel.app —
# credentials are allowed, so a wildcard lets any deployment of that
# host call the API authenticated.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ── SERVER ────────────────────────────────────────────────
# Spring Boot listens on 8080 inside the container.
SERVER_PORT=8080

# ── CONNECTION POOL ───────────────────────────────────────
# Total DB connections = (number of backend instances) × DB_POOL_MAX.
DB_POOL_MAX=10
DB_POOL_MIN=2

# ── RATE LIMITING ─────────────────────────────────────────
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_SIGNUP_WINDOW=3600
RATE_LIMIT_API=120
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_REPORTS=20
RATE_LIMIT_REPORTS_WINDOW=60

# ── CACHE TTLS (seconds) ──────────────────────────────────
CACHE_CATEGORY_TTL=300
CACHE_WAREHOUSE_TTL=300
CACHE_DASHBOARD_TTL=30
CACHE_PRODUCT_TTL=120

# ── READ REPLICA (optional) ───────────────────────────────
# Leave unset for a single-node setup. When set, read-only
# transactions are routed to the replica; writes always use the primary.
# READ_REPLICA_URL=jdbc:postgresql://replica:5432/stockflow_db
# READ_REPLICA_USERNAME=stockflow
# READ_REPLICA_PASSWORD=CHANGE_ME_REPLICA_PASSWORD

# ── INTELLIGENCE SERVICE ──────────────────────────────────
# Every forecast, alert and recommendation is computed from this
# application's own recorded transactions, in Java, inside this
# service. There is no external AI provider, no API key and no
# outbound network call of any kind. Nothing here is a secret,
# because there is nothing to keep secret — and there is
# deliberately no AI_PROVIDER_API_KEY variable, because a key that
# nothing reads is a key that will be committed by accident.
#
# Setting AI_ENABLED=false disables every /api/v1/ai endpoint. The
# dashboards, reports and financial figures continue to work: they
# are computed by the reporting layer, not by these models.
AI_ENABLED=true

# How much history the models may look at.
AI_HISTORY_DAYS=540
AI_DEMAND_HISTORY_DAYS=365

# Prediction interval width, e.g. 0.95 for 95%.
AI_CONFIDENCE=0.95

# Horizon offered by the daily view, in days.
AI_DAILY_HORIZON=14
AI_MAX_DEMAND_MODELS=25

# A product with fewer recorded days than this is reported as
# unforecastable rather than guessed at. Recommendations for it fall
# back to its configured reorder level.
AI_MIN_DEMAND_OBSERVATIONS=28

# Anomaly detection. A day is raised only when it is BOTH
# statistically unusual (modified z-score at or above the threshold,
# after the weekly pattern is removed) AND materially different in
# money (at least the relative-deviation floor). The second test is
# what stops a small business's ordinary variation from filling the
# alerts panel and training people to dismiss it.
AI_ANOMALY_THRESHOLD=3.5
AI_ANOMALY_MIN_OBSERVATIONS=8
AI_ANOMALY_MIN_RELATIVE_DEVIATION=0.30

# A movement of this many units with no stated reason is raised.
AI_LARGE_MOVEMENT_THRESHOLD=50

# Days without a sale after which stock is called slow-moving.
AI_SLOW_MOVING_DAYS=60

# Inventory advice. The lead time is a DEFAULT, not a measurement:
# until supplier lead times are recorded, every recommendation states
# that it assumed this many days.
AI_DEFAULT_LEAD_TIME_DAYS=7
AI_SERVICE_LEVEL=0.95

# Whether training results are written to the model registry. Leave
# on: turning it off means a figure already reported can no longer be
# traced to the model that produced it.
AI_PERSIST_MODEL_VERSIONS=true

# Below this confidence the assistant asks which report was meant
# rather than answering a question it has only partly understood.
AI_ASSISTANT_MIN_CONFIDENCE=0.35

# ── CHATBOT ───────────────────────────────────────────
# The chatbot answers from the same services the reports use, so its
# figures are the reports' figures. Leave CHATBOT_PROVIDER as
# "deterministic" and no network call is ever made — this is also the
# mode to use for offline development and testing.
#
# To re-word answers with a language model, set the provider to
# "openai-compatible", give the endpoint and the key, and restart.
# The key is read here, on the server, and is never returned by any
# endpoint, never logged, and never placed in the frontend.
#
# The endpoint accepts either shape:
#   CHATBOT_API_URL=https://api.openai.com/v1/chat/completions   (the full endpoint)
#   CHATBOT_API_URL=https://api.openai.com/v1                 (a base URL)
# The /chat/completions suffix is appended only when it is missing.
CHATBOT_ENABLED=true
CHATBOT_PROVIDER=deterministic
CHATBOT_API_URL=
# The server-side secret. The backend reads CHATBOT_API_KEY first and falls
# back to OPENAI_API_KEY when the first is absent or empty, so either name
# works and a deployment passing both (one of them blank) resolves fine.
# Create the key at https://platform.openai.com/api-keys and uncomment ONE
# line below with the real value — never in this example file, never in the
# frontend, never in a log. Neither name set means the deterministic provider
# with no outbound request, which is the shipped default.
# CHATBOT_API_KEY=
# OPENAI_API_KEY=
CHATBOT_MODEL=gpt-4o-mini
# A hung provider must never hang the chatbot: the deterministic
# answer is always the fallback, so the timeout is short.
CHATBOT_TIMEOUT_MS=15000
CHATBOT_MAX_TOKENS=900
# Set false to guarantee no outbound call is ever made, even if a
# key is present. This is a guarantee, not a preference: with it false
# the provider is not contacted at all.
CHATBOT_LLM_PHRASED=true
# The most tool output a provider is ever shown.
CHATBOT_MAX_CONTEXT_CHARS=6000
# How well a question must be understood before it is answered
# rather than clarified.
CHATBOT_MIN_CONFIDENCE=0.45
# Retention. A customer asking about an order is not asking to be
# remembered, so customer conversations expire sooner than staff's.
# Conversations past their date are DELETED, not hidden.
CHATBOT_STAFF_RETENTION_DAYS=90
CHATBOT_CUSTOMER_RETENTION_DAYS=30
# A customer session token's lifetime, in hours.
CHATBOT_SESSION_TTL_HOURS=12
# A conversation stops growing here; older messages are dropped.
CHATBOT_MAX_MESSAGES=100
# Per-actor rate limit, counted separately from the API budget.
CHATBOT_MESSAGES_PER_WINDOW=30
CHATBOT_WINDOW_SECONDS=60

# ── REPORTS AND EXPORTS ────────────────────────────────────
# Exporting a report produces the file on the server from the same
# data the screen showed, so an exported file can never contain a
# figure the screen did not.
REPORT_EXPORT_MAX_ROWS=10000

# ── SUPER ADMIN ───────────────────────────────────────────
SUPER_ADMIN_USERNAME=CHANGE_ME
SUPER_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ── FRONTEND ──────────────────────────────────────────────
# Public values — safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=StockFlow
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1