# ==========================================
# StockFlow — Master Project .gitignore
# ==========================================

# ── Dependencies & Package Managers ───────────
node_modules/
.pnp
.pnp.js
target/
.mvn/wrapper/maven-wrapper.jar

# ── Environment & Secrets ─────────────────────
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Next.js & Build Outputs ───────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Logs & Debugging ──────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── Java & Spring Boot Artifacts ──────────────
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ── IDE & Editor Configurations ───────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Testing & Coverage ────────────────────────
coverage/
.nyc_output/

# ── Tooling & AI Caches ───────────────────────
.refact/
.gemini/

# ── Docker & Local Overrides ──────────────────
docker-compose.override.yml
